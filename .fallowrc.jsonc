{
  "$schema": "./node_modules/fallow/schema.json",
  "workspaces": { "patterns": ["apps/*", "packages/*"] },
  // The packages are internal: their package.json exports are not a public API, so unused exports are reported there too
  "includeEntryExports": true,

  // Architecture: core holds the logic; server and CLI build on it; the web UI talks to the server over HTTP
  // and may only use core's types (the shared API contract), never its runtime code.
  // Inside core, the domain folders build on the shared base (contract, config, errors and the test helpers).
  // image and elements import each other: refs.ts uses image/heic.ts, generation and prompts use the elements.
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/src/{config,config.test,contract,errors}.ts", "packages/core/test/**"]
      },
      { "name": "core-openrouter", "patterns": ["packages/core/src/openrouter/**"] },
      { "name": "core-models", "patterns": ["packages/core/src/models/**"] },
      { "name": "core-image", "patterns": ["packages/core/src/image/**"] },
      { "name": "core-elements", "patterns": ["packages/core/src/elements/**"] },
      { "name": "core-audio", "patterns": ["packages/core/src/audio/**"] },
      { "name": "core-storage", "patterns": ["packages/core/src/storage/**"] },
      { "name": "core-system", "patterns": ["packages/core/src/system/**"] },
      { "name": "server", "patterns": ["apps/server/**"] },
      { "name": "cli", "patterns": ["apps/cli/**"] },
      { "name": "web", "patterns": ["apps/web/**"] },
      { "name": "scripts", "patterns": ["scripts/**"] }
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "core-storage", "allow": ["core"] },
      { "from": "core-system", "allow": ["core"] },
      { "from": "core-openrouter", "allow": ["core", "core-storage"] },
      { "from": "core-elements", "allow": ["core", "core-storage", "core-image"] },
      { "from": "core-image", "allow": ["core", "core-storage", "core-system", "core-openrouter", "core-elements"] },
      { "from": "core-models", "allow": ["core", "core-storage", "core-openrouter", "core-image"] },
      { "from": "core-audio", "allow": ["core", "core-storage", "core-system", "core-openrouter", "core-elements"] },
      {
        "from": "server",
        "allow": [
          "core",
          "core-openrouter",
          "core-models",
          "core-image",
          "core-elements",
          "core-audio",
          "core-storage",
          "core-system"
        ]
      },
      {
        "from": "cli",
        "allow": [
          "core",
          "core-openrouter",
          "core-models",
          "core-image",
          "core-elements",
          "core-audio",
          "core-storage",
          "core-system"
        ]
      },
      { "from": "web", "allow": [], "allowTypeOnly": ["core"] },
      { "from": "scripts", "allow": [] }
    ]
  },

  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    // CRAP = complexity² × untested share + complexity. 60 means: untested functions stay small (≈ 7 branches),
    // more complex logic needs tests. Without coverage data fallow estimates coverage from the test files.
    "maxCrap": 60
  }
}
