# Copy to .env and add your key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional
# PORT=5177
# REF_MAX_SIDE=1024              # longest side of reference images in px
# REQUEST_TIMEOUT_MS=300000      # generations can take > 90 s
# DEFAULT_MODEL=google/gemini-3.1-flash-image
# PRIVACY=zdr                    # zdr | zdr-strict | off
# OUT_DIR=out  REFS_DIR=refs  VOICES_DIR=voices
# TRANSCRIBE=local                # local (Whisper offline) | api (OpenRouter, ZDR)
# WHISPER_MODEL=onnx-community/whisper-small   # e.g. onnx-community/whisper-large-v3-turbo (larger, more accurate)
# TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
